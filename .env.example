# Telegram bot token from BotFather. Do not commit a real token.
BOT_TOKEN=123456:replace_me

# Folder where command scripts live. Use /app/scripts in Docker.
SCRIPTS_DIR=./scripts

# Optional comma-separated Telegram chat IDs allowed to use the bot.
# Leave empty during local testing only.
ALLOWED_CHAT_IDS=

# Script timeout in seconds.
SCRIPT_TIMEOUT_SECONDS=60

# Max characters returned to Telegram from script output.
MAX_OUTPUT_CHARS=3500
